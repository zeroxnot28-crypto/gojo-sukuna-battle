const held = new Set();
const pad = document.createElement('div');
pad.style.cssText =
  'position:fixed;bottom:20px;left:15px;display:grid;' +
  'grid-template-columns:repeat(3,52px);gap:5px;z-index:5;';
document.body.appendChild(pad);

function button(label, direction) {
  const b = document.createElement('button');
  b.textContent = label;
  b.style.cssText =
    'height:52px;width:52px;background:#243b55;color:white;' +
    'border:1px solid white;border-radius:12px;font-size:22px;' +
    'touch-action:none;';
  b.onpointerdown = e => {
    e.preventDefault();
    held.add(direction);
    b.setPointerCapture(e.pointerId);
  };
  const release = () => held.delete(direction);
  b.onpointerup = release;
  b.onpointercancel = release;
  b.onlostpointercapture = release;
  pad.appendChild(b);
}

function empty() {
  const d = document.createElement('div');
  pad.appendChild(d);
}

empty(); button('▲', 'up'); empty();
button('◀', 'left'); button('▼', 'down');
button('▶', 'right');

const clock = new THREE.Clock();

function animate() {
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);
  const speed = 5 * dt;

  if (held.has('up')) player.position.z -= speed;
  if (held.has('down')) player.position.z += speed;
  if (held.has('left')) player.position.x -= speed;
  if (held.has('right')) player.position.x += speed;

  player.position.x = THREE.MathUtils.clamp(player.position.x, -95, 95);
  player.position.z = THREE.MathUtils.clamp(player.position.z, -95, 95);

  enemy.rotation.y += dt;
  camera.position.set(
    player.position.x,
    player.position.y + 5,
    player.position.z + 8
  );
  camera.lookAt(player.position);
  renderer.render(scene, camera);
}

camera.position.set(0, 6, 8);
window.addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

animate();
