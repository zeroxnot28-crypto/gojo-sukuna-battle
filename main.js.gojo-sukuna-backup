// Mountain ranges surrounding the battlefield
function addMountain(x, z, radius, height, color) {
  const mountain = new THREE.Mesh(
    new THREE.ConeGeometry(radius, height, 7, 3),
    new THREE.MeshStandardMaterial({
      color: color,
      roughness: 1,
      flatShading: true
    })
  );

  mountain.position.set(x, height / 2 - 0.5, z);
  mountain.castShadow = true;
  mountain.receiveShadow = true;
  scene.add(mountain);

  // Snow caps near the peaks
  if (height > 15) {
    const snow = new THREE.Mesh(
      new THREE.ConeGeometry(radius * 0.3, height * 0.23, 7),
      new THREE.MeshStandardMaterial({
        color: 0xeaf4f7,
        roughness: 1,
        flatShading: true
      })
    );
    snow.position.set(
      x,
      height - height * 0.115 - 0.5,
      z
    );
    scene.add(snow);
  }
}

