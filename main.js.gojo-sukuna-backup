function addTree(x, z) {
  const trunk = new THREE.Mesh(
    new THREE.CylinderGeometry(0.15, 0.22, 1.5, 6),
    new THREE.MeshStandardMaterial({ color: 0x79502f })
  );
  trunk.position.set(x, 0.75, z);
  trunk.castShadow = true;
scene.add(trunk);

  const leaves = new THREE.Mesh(
    new THREE.ConeGeometry(1, 2.5, 7),
    new THREE.MeshStandardMaterial({ color: 0x176b35 })
  );
  leaves.position.set(x, 2.5, z);
  leaves.castShadow = true;
scene.add(leaves);
}

function addRock(x, z, size) {
  const rock = new THREE.Mesh(
    new THREE.DodecahedronGeometry(size),
    new THREE.MeshStandardMaterial({ color: 0x777777 })
  );
  rock.position.set(x, size * 0.6, z);
  rock.castShadow = true;
scene.add(rock);
}

for (let i = 0; i < 14; i++) {
  const x = (Math.random() - 0.5) * 45;
  const z = (Math.random() - 0.5) * 45;
  if (Math.abs(x) < 5 && Math.abs(z) < 5) continue;
  if (i % 2 === 0) addTree(x, z);
  else addRock(x, z, 0.4 + Math.random() * 0.6);
}


function makeCharacter(color, skinColor) {
  const character = new THREE.Group();

  const outfit = new THREE.MeshStandardMaterial({
    color: color, roughness: 0.85
  });
  const skin = new THREE.MeshStandardMaterial({
    color: skinColor, roughness: 0.9
  });
  const dark = new THREE.MeshStandardMaterial({
    color: 0x26313c, roughness: 1
  });

  function part(geometry, material, x, y, z) {
    const mesh = new THREE.Mesh(geometry, material);
    mesh.position.set(x, y, z);
    mesh.castShadow = true;
    character.add(mesh);
    return mesh;
  }

  // Legs and boots
  part(new THREE.CapsuleGeometry(0.16, 0.48, 3, 6),
       outfit, -0.22, -0.48, 0);
  part(new THREE.CapsuleGeometry(0.16, 0.48, 3, 6),
       outfit, 0.22, -0.48, 0);
  part(new THREE.BoxGeometry(0.3, 0.15, 0.4),
       dark, -0.22, -0.79, -0.06);
  part(new THREE.BoxGeometry(0.3, 0.15, 0.4),
       dark, 0.22, -0.79, -0.06);

  // Body and shoulders
  part(new THREE.CapsuleGeometry(0.34, 0.48, 4, 8),
       outfit, 0, 0.13, 0);

  // Arms
  const leftArm = part(
    new THREE.CapsuleGeometry(0.105, 0.48, 3, 6),
    outfit, -0.43, 0.1, 0
  );
  leftArm.rotation.z = -0.15;

  const rightArm = part(
    new THREE.CapsuleGeometry(0.105, 0.48, 3, 6),
    outfit, 0.43, 0.1, 0
  );
  rightArm.rotation.z = 0.15;

  // Hands
  part(new THREE.SphereGeometry(0.12, 8, 6),
       skin, -0.45, -0.19, 0);
  part(new THREE.SphereGeometry(0.12, 8, 6),
       skin, 0.45, -0.19, 0);

  // Neck and head
  part(new THREE.CylinderGeometry(0.11, 0.13, 0.18, 8),
       skin, 0, 0.52, 0);
  part(new THREE.SphereGeometry(0.25, 12, 10),
       skin, 0, 0.83, 0);

  // Hair and simple eyes
  part(new THREE.SphereGeometry(0.255, 10, 6, 0, Math.PI * 2, 0, 1.4),
       dark, 0, 0.91, 0);

  const eyeMaterial = new THREE.MeshBasicMaterial({ color: 0x171717 });
  part(new THREE.SphereGeometry(0.025, 6, 6),
       eyeMaterial, -0.09, 0.85, -0.225);
  part(new THREE.SphereGeometry(0.025, 6, 6),
       eyeMaterial, 0.09, 0.85, -0.225);

  return character;
}

